# Copy to .env and fill in what you need. Loaded via dotenv; in cloud environments the same
# names can arrive as plain environment variables instead.

# GPT-4.1 generation and fine-tuning, the GPT-5.6 judges, the gpt-4.1-mini / gpt-5-mini
# graders, and the embedding helpers of the nl_gameable graders.
OPENAI_API_KEY=

# The strict misalignment judge (Claude Sonnet 4.6) and its output-only pass (Claude Opus 4.6).
ANTHROPIC_API_KEY=

# The LLM helpers of the nl_gameable programmatic graders (llm_count, llm_rubric_score, ...).
OPENROUTER_API_KEY=

# Qwen3-235B GRPO training (experiments/qwen_235b_a22b_instruct_grpo/1a_grpo.py).
TINKER_API_KEY=
WANDB_API_KEY=

# Serving Qwen3-235B and its LoRA adapter on Modal (--provider modal): your Modal workspace
# name and the vLLM server API key (must equal the `vllm-api-key` Modal secret).
MODAL_WORKSPACE=
MODAL_VLLM_API_KEY=

# Downloading the Qwen3-235B weights and the released adapter.
HF_TOKEN=
